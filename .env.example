# Reference only: export values in your shell or use your approved secret manager.
# This application does not auto-load this file.
ADO_ORGANIZATION=swissreghcpsdkdemo
ADO_PROJECT=CoP-agentic-sdlc-demo
# Optional: only unmanaged User Story intake. Managed create-story/reset pin IDs in a local journal.
# ADO_WORK_ITEM_ID=
ADO_PAT=
# Alternative to PAT: an Entra access token for Azure DevOps.
# ADO_TOKEN=
DEMO_MODEL=
# For Copilot-backed inference, omit ALL endpoint/provider/key settings below.
DEMO_MODEL_ENDPOINT=
DEMO_PROVIDER=openai
DEMO_WIRE_API=completions
DEMO_MODEL_API_KEY=
# Alternative BYOK authentication:
# DEMO_MODEL_BEARER_TOKEN=
# Required for the HTTP host; at least 32 random characters, never model context:
DEMO_APPROVAL_TOKEN=
# Hosted setup uses azd environment values; see deploy/README.md.
# deploy/client.py acquires fresh Entra tokens per invocation and reads the
# generated presenter secret and session record from ignored .azure/ files.
